---
import AuthLayout from "../../layouts/AuthLayout.astro";
import LoginForm from "../../components/auth/LoginForm";
export const prerender = false;

const supabase = Astro.locals.supabase;
const { data: { user } } = await supabase.auth.getUser();
if (user) {
  return Astro.redirect('/study');
}
---

<AuthLayout title="Zaloguj się" subtitle="Wpisz swoje dane, aby kontynuować.">
  <LoginForm client:load />
  <div slot="footer" class="mt-3 text-center text-sm text-gray-600">
    Nie masz konta? <a class="underline" href="/auth/register">Zarejestruj się</a>
    <span class="mx-2">•</span>
    <a class="underline" href="/auth/reset-password">Nie pamiętasz hasła?</a>
  </div>
</AuthLayout>
