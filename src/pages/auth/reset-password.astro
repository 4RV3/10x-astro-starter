---
import AuthLayout from "../../layouts/AuthLayout.astro";
import RequestPasswordResetForm from "../../components/auth/RequestPasswordResetForm";
---

<AuthLayout title="Reset hasła" subtitle="Wyślemy instrukcje na Twój adres e‑mail.">
  <RequestPasswordResetForm client:load />
  <div slot="footer" class="mt-3 text-center text-sm text-gray-600">
    Pamiętasz hasło? <a class="underline" href="/auth/login">Wróć do logowania</a>
  </div>
</AuthLayout>
