---
import "../styles/global.css";
const supabase = Astro.locals.supabase;
const {
  data: { user },
} = await supabase.auth.getUser();
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>10x Cards</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="sticky top-0 z-10 border-b bg-white/90 backdrop-blur">
      <div class="mx-auto max-w-7xl px-4 py-3 flex items-center justify-between">
        <a href="/study" class="font-semibold">10x Cards</a>
        <div class="flex items-center gap-4">
          <nav class="hidden md:flex gap-4 text-sm">
            <a href="/study" class="hover:underline">Powtórki</a>
            <a href="/cards" class="hover:underline">Fiszki</a>
            <a href="/ai/generate" class="hover:underline">Generator AI</a>
            <a href="/cards/new" class="hover:underline">Dodaj ręcznie</a>
            <a href="/profile" class="hover:underline">Profil</a>
          </nav>
          {
            user ? (
              <button data-action="logout" class="text-sm px-3 py-1.5 rounded border hover:bg-gray-50">
                Wyloguj
              </button>
            ) : (
              <a href="/auth/login" class="text-sm px-3 py-1.5 rounded border hover:bg-gray-50">
                Zaloguj
              </a>
            )
          }
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-6">
      <slot />
    </main>
    <nav class="fixed bottom-0 left-0 right-0 md:hidden border-t bg-white">
      <div class="mx-auto max-w-7xl grid grid-cols-5 text-center text-xs">
        <a href="/study" class="py-3">Powtórki</a>
        <a href="/cards" class="py-3">Fiszki</a>
        <a href="/ai/generate" class="py-3">AI</a>
        <a href="/cards/new" class="py-3">Dodaj</a>
        {
          user ? (
            <button data-action="logout" class="py-3">
              Wyloguj
            </button>
          ) : (
            <a href="/auth/login" class="py-3">
              Profil
            </a>
          )
        }
      </div>
    </nav>
    <script>
      for (const el of document.querySelectorAll('[data-action="logout"]')) {
        el.addEventListener("click", async (e) => {
          e.preventDefault();
          try {
            await fetch("/api/auth/logout", { method: "POST" });
          } catch {}
          window.location.href = "/auth/login";
        });
      }
    </script>
  </body>
</html>
