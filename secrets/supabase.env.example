# Supabase Environment Variables
# Copy this to /opt/10xcards/secrets/supabase.env on VPS

# IMPORTANT: Generate your own secure values!
# You can use: openssl rand -base64 32

# Database password
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# JWT Secret (must be at least 32 characters)
JWT_SECRET=YOUR_JWT_SECRET_HERE

# JWT expiry in seconds
JWT_EXPIRY=3600

# Generate these using the JWT_SECRET:
# IMPORTANT: Use the generate-jwt-tokens.sh script to create valid tokens
# ./generate-jwt-tokens.sh "YOUR_JWT_SECRET"
# This ensures exp and iat are numbers, not strings (required by Supabase)

ANON_KEY=YOUR_ANON_KEY_HERE
SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Secret key base for Realtime
SECRET_KEY_BASE=YOUR_SECRET_KEY_BASE_HERE
